#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Syna3DSTools.manifest"
IDI_APP ICON "icon.ico"

IDD_SETTINGS DIALOGEX 0, 0, 262, 140
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Syna 3DS Tools - Settings"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT           "Enter the IP address and port shown on the 3DS top screen.", -1, 8, 8, 246, 10
    LTEXT           "IP address:", -1, 8, 27, 66, 10
    EDITTEXT        IDC_HOST, 78, 25, 176, 13, ES_AUTOHSCROLL
    LTEXT           "Port:", -1, 8, 46, 66, 10
    EDITTEXT        IDC_PORT, 78, 44, 50, 13, ES_NUMBER
    LTEXT           "Send to PC folder:", -1, 8, 69, 66, 10
    EDITTEXT        IDC_SENDDIR, 78, 67, 124, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE, 206, 66, 48, 15
    AUTOCHECKBOX    "", IDC_DARK, 78, 90, 10, 10
    LTEXT           "Dark mode", -1, 91, 90, 100, 10
    DEFPUSHBUTTON   "OK", IDOK, 150, 118, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 204, 118, 50, 14
END
