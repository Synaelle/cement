#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "synaftp.manifest"
IDI_APP ICON "icon.ico"

IDD_SERVER DIALOGEX 0, 0, 220, 92
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Connect to 3DS"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
    LTEXT           "Enter the IP address and port shown on the 3DS screen.", -1, 8, 8, 204, 10
    LTEXT           "IP address:", -1, 8, 27, 50, 10
    EDITTEXT        IDC_HOST, 62, 25, 150, 13, ES_AUTOHSCROLL
    LTEXT           "Port:", -1, 8, 46, 50, 10
    EDITTEXT        IDC_PORT, 62, 44, 50, 13, ES_NUMBER
    DEFPUSHBUTTON   "OK", IDOK, 108, 70, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 162, 70, 50, 14
END
